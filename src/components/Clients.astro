---
import { uaeClientLogos, indiaClientLogos } from '../data/clients';

interface Props {
  region: 'uae' | 'india';
}
const { region } = Astro.props;
const clients = region === 'uae' ? uaeClientLogos : indiaClientLogos;
---

<section id="clients" class="py-16 md:py-24 bg-white border-t border-slate-100 scroll-mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 reveal-up">
      <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Our Clients</p>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
        {region === 'uae' ? 'Trusted by Leading Organizations in the GCC' : 'Experience Supporting Leading Organizations'}
      </h2>
      <p class="text-slate-500 text-sm md:text-base">
        {region === 'uae'
          ? 'Serving major oil & gas, energy, and logistics operators across the UAE and Gulf region.'
          : 'Partnering with multinational and Indian enterprises across supply chain, steel, and transport.'}
      </p>
    </div>

    <div class="reveal-up grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 mb-8">
      {clients.map((client, i) => (
        <div
          class="group flex flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white p-5 md:p-6 min-h-[100px] hover:border-teal-200 hover:shadow-lg hover:shadow-teal-50/50 transition-all duration-300"
          style={`transition-delay: ${i * 40}ms`}
        >
          {client.logo ? (
            <img
              src={client.logo}
              alt={`${client.name} logo`}
              class="h-10 md:h-12 w-auto max-w-full object-contain grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-300 mb-2"
              loading="lazy"
              width="120"
              height="48"
            />
          ) : (
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl text-white font-bold text-sm mb-2"
              style={`background-color: ${client.color ?? '#475569'}`}
            >
              {client.abbr}
            </div>
          )}
          <span class="text-[11px] text-slate-400 text-center leading-tight font-medium group-hover:text-teal-700 transition-colors">{client.name}</span>
        </div>
      ))}
    </div>

  </div>
</section>
