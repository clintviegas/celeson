---
import { getInsightsForRegion, getInsight } from '../data/insights';
import type { BusinessRegion } from '../data/brief';

interface Props {
  region: BusinessRegion;
  limit?: number;
  compact?: boolean;
  featuredSlugs?: string[];
}
const { region, limit, compact = false, featuredSlugs } = Astro.props;

let articles = featuredSlugs?.length
  ? featuredSlugs.map((slug) => getInsight(slug)).filter(Boolean)
  : getInsightsForRegion(region, limit);

if (!featuredSlugs?.length && limit) {
  articles = articles.slice(0, limit);
}

const base = `/${region}`;
---

<section class={compact ? 'py-12 md:py-16 bg-slate-50' : 'py-16 md:py-24 bg-slate-50'}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {!compact && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {articles.map((article) => article && (
          <article class="rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-lg transition-shadow">
            <a href={`${base}/insights/${article.slug}`} class="block">
              <div class="aspect-[16/10] overflow-hidden">
                <img src={article.image} alt={article.title} class="w-full h-full object-cover hover:scale-[1.02] transition-transform duration-500" loading="lazy" />
              </div>
              <div class="p-5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-600">{article.category}</span>
                <h3 class="text-base font-bold text-slate-900 leading-snug mt-1 mb-2">{article.title}</h3>
                <p class="text-sm text-slate-500 line-clamp-2">{article.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
    {compact && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {articles.map((article) => article && (
          <article class="rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-lg transition-shadow">
            <a href={`${base}/insights/${article.slug}`} class="flex flex-col h-full">
              <div class="aspect-[16/10] overflow-hidden">
                <img src={article.image} alt={article.title} class="w-full h-full object-cover min-h-[140px]" loading="lazy" />
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-600">{article.category}</span>
                <h3 class="text-base font-bold text-slate-900 leading-snug mt-1 mb-2">{article.title}</h3>
                <p class="text-sm text-slate-500 line-clamp-2 flex-1">{article.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
