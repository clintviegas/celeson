---
import { contact } from '../data/content';
import type { BusinessRegion } from '../data/brief';
import { getRegionLabel } from '../data/regionNav';

interface Props {
  region: BusinessRegion;
}
const { region } = Astro.props;
const regionContact = region === 'uae' ? contact.uae : contact.india;
const regionLabel = getRegionLabel(region);
---

<section class="py-14 md:py-16 bg-[#0b1929]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-4">Ready to work with us?</h2>
    <p class="text-slate-400 max-w-xl mx-auto mb-8">Speak directly with our {regionLabel} team — no forms, no waiting.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={`tel:${regionContact.tel}`} class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-teal-600 px-8 py-3.5 text-sm font-semibold text-white hover:bg-teal-500 transition-all shadow-lg shadow-teal-900/30">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        Call Us
      </a>
    </div>
  </div>
</section>
