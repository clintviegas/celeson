---
interface Props {
  title: string;
  subtitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
}
const { title, subtitle, breadcrumbs } = Astro.props;
---

<section class="bg-[#0b1929] pt-[4.25rem] pb-10 sm:pb-12 md:pb-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-slate-500" aria-label="Breadcrumb">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <span aria-hidden="true">›</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-teal-400 transition-colors">{crumb.label}</a>
            ) : (
              <span class="text-teal-400">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>
    )}
    {subtitle && <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest mb-2">{subtitle}</p>}
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight max-w-3xl">{title}</h1>
  </div>
</section>
