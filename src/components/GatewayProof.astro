---
const stories = [
  {
    tag: 'India · Project',
    title: 'Integrated Steel Plant Supply Chain Assessment',
    excerpt: 'End-to-end logistics assessment — inbound raw materials, internal handling, and outbound steel across multimodal corridors.',
    href: '/india/insights/integrated-steel-plant-supply-chain-india',
    image: '/images/project-steel-plant-india.png',
    imageClass: 'object-cover',
  },
  {
    tag: 'India · Kori Café',
    title: 'Kori Café — Hospitality Flagship, Bandra West',
    excerpt: 'Family-run café blending Coorg coffee heritage, wellness-focused F&B, and the same operational discipline as Celeson\'s safety work.',
    href: '/india/insights/kori-cafe-hospitality-india',
    image: '/images/kori-cafe-exterior.png',
    imageClass: 'object-cover object-center',
  },
  {
    tag: 'Leadership · RoSPA Gold',
    title: 'RoSPA Gold Award — Birmingham, UK',
    excerpt: 'Recognising excellence in health, safety and risk management — a milestone reflecting teamwork, discipline, and world-class safety culture.',
    href: '/india/insights/rospa-gold-award-safety-excellence',
    image: '/images/arun-rospa-gold-award.png',
    imageClass: 'object-cover object-top',
  },
  {
    tag: 'UAE · Speaker',
    title: 'Dubai Chamber — Road Safety & Driver Awareness',
    excerpt: 'Regular speaker on driver behaviour, operational excellence, transport safety, and fleet performance across industry forums.',
    href: '/uae/insights/arundhan-alphones-dubai-chamber-road-safety-speaker',
    image: '/images/arun-dubai-chamber-speaker.png',
    imageClass: 'object-cover object-top',
  },
];
---

<section id="proof" class="relative py-16 md:py-20 scroll-mt-24 bg-[#071018] border-t border-white/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10 md:mb-12">
      <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest mb-3">Proof & Case Studies</p>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">Real Projects. Real Recognition.</h2>
      <p class="text-slate-400 text-sm leading-relaxed">
        From steel plant logistics in India to the RoSPA Gold Award and Dubai Chamber speaking — plus Kori Café, our hospitality brand in Mumbai.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 lg:gap-6">
      {stories.map((story) => (
        <a
          href={story.href}
          class="group rounded-2xl border border-white/10 bg-white/[0.03] overflow-hidden hover:border-teal-500/30 hover:bg-white/[0.05] transition-all flex flex-col sm:flex-row"
        >
          <div class="sm:w-[42%] aspect-[4/3] sm:aspect-auto sm:min-h-[200px] overflow-hidden flex-shrink-0">
            <img
              src={story.image}
              alt=""
              class={`w-full h-full min-h-[180px] ${story.imageClass} group-hover:scale-[1.02] transition-transform duration-500`}
              loading="lazy"
            />
          </div>
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-center">
            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-400 mb-2">{story.tag}</span>
            <h3 class="text-base font-bold text-white leading-snug mb-2 group-hover:text-teal-300 transition-colors">
              {story.title}
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed line-clamp-3 mb-3">{story.excerpt}</p>
            <span class="text-sm font-semibold text-teal-400 inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Read Case Study →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
