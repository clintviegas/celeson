---
import { vision, mission, philosophy, whoWeAre, valuePillars } from '../data/content';

const pillars = [
  { label: '33+ Years', desc: 'Multinational leadership' },
  { label: 'Goal Zero', desc: 'No harm to people or planet' },
  { label: 'Predict. Prevent. Protect.', desc: 'Core philosophy' },
  { label: 'India & GCC', desc: 'Dual-region operations' },
];
---

<section id="about" class="relative py-16 md:py-24 scroll-mt-24 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-[#0b1929] via-[#071820] to-[#071018]" aria-hidden="true"></div>
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <svg width="100%" height="100%"><defs><pattern id="about-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="white"/></pattern></defs><rect width="100%" height="100%" fill="url(#about-dots)"/></svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
      <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest mb-3">About Celeson</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Who We Are</h2>
      <p class="text-slate-400 leading-relaxed">{whoWeAre}</p>
      <a href="#regions" class="inline-flex mt-6 text-sm font-semibold text-teal-400 hover:text-teal-300">Ready to explore? Choose a region ↑</a>
    </div>

    <div class="grid lg:grid-cols-3 gap-5 mb-10">
      <div class="lg:col-span-2 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-sm p-6 md:p-8">
        <h3 class="text-lg font-bold text-teal-400 mb-3">Our Vision</h3>
        <p class="text-sm text-slate-300 leading-relaxed">{vision}</p>
      </div>
      <div class="rounded-2xl border border-teal-500/25 bg-gradient-to-br from-teal-500/10 to-transparent p-6 md:p-8">
        <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest mb-2">Philosophy</p>
        <p class="text-xl font-extrabold text-white mb-2">{philosophy.headline}</p>
        <p class="text-sm text-slate-400 leading-relaxed">{philosophy.body}</p>
      </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8 mb-10">
      <h3 class="text-lg font-bold text-teal-400 mb-4">Our Mission</h3>
      <ul class="grid sm:grid-cols-2 gap-3">
        {mission.map(m => (
          <li class="flex items-start gap-2.5 text-sm text-slate-300">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-teal-500 flex-shrink-0"></span>
            {m}
          </li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-10">
      {pillars.map(p => (
        <div class="rounded-xl border border-white/10 bg-white/[0.04] p-4 text-center">
          <div class="text-sm font-bold text-teal-400 mb-1">{p.label}</div>
          <div class="text-xs text-slate-500">{p.desc}</div>
        </div>
      ))}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {valuePillars.map(v => (
        <div class="rounded-xl border border-white/8 bg-white/[0.02] p-4 hover:border-teal-500/20 transition-colors">
          <div class="text-sm font-bold text-white mb-1">{v.title}</div>
          <div class="text-xs text-slate-500 leading-relaxed">{v.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
