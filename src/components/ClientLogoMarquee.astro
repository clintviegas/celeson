---
import { getClientLogos } from '../data/clients';
import type { BusinessRegion } from '../data/brief';

interface Props {
  region: BusinessRegion;
}
const { region } = Astro.props;
const clients = getClientLogos(region);
const doubled = [...clients, ...clients];
---

<section id="clients" class="py-16 md:py-20 bg-slate-50 border-y border-slate-100 scroll-mt-20 overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-10">
    <p class="text-center text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Our Clients</p>
    <h2 class="text-center text-xl sm:text-2xl font-extrabold text-slate-900">Trusted by leading organisations</h2>
  </div>

  <div class="relative">
    <div class="absolute left-0 top-0 bottom-0 w-20 sm:w-32 bg-gradient-to-r from-slate-50 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-20 sm:w-32 bg-gradient-to-l from-slate-50 to-transparent z-10 pointer-events-none"></div>
    <div class="overflow-hidden">
      <div class="logo-marquee-track flex items-center gap-16 sm:gap-20 px-10">
        {doubled.map((client) => (
          <div class="logo-marquee-item flex-shrink-0 flex items-center justify-center min-w-[160px] sm:min-w-[180px]" title={client.name}>
            <img src={client.logo} alt={client.name} loading="lazy" width="200" height="80" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
