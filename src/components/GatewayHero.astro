---
import { energyTransport, logoSrc } from '../data/content';
---

<section class="relative pt-[4.25rem] overflow-hidden bg-[#0b1929]">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[600px] h-[500px] bg-slate-700/10 rounded-full blur-[120px]"></div>
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 md:py-14 lg:py-16">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">
      <div class="text-center lg:text-left">
        <div class="flex justify-center lg:justify-start mb-5">
          <img src={logoSrc} alt="Celeson" class="h-10 sm:h-12 w-auto object-contain" loading="eager" width="200" height="59" />
        </div>

        <p class="text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-4">{energyTransport.eyebrow}</p>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-extrabold text-slate-100 tracking-tight leading-tight mb-5 text-balance">
          {energyTransport.headline}
        </h1>
        <p class="text-slate-400 text-base sm:text-lg leading-relaxed mb-4 max-w-xl mx-auto lg:mx-0">
          {energyTransport.body}
        </p>
        <p class="text-sm font-medium text-brand-slate mb-8 max-w-xl mx-auto lg:mx-0">
          {energyTransport.fleetNote}
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 mb-4">
          <a href="/india/contact?topic=energy-transport" class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-slate px-7 py-3.5 text-sm font-semibold text-slate-100 hover:bg-slate-600 transition-colors shadow-lg shadow-black/20">
            Enquire — India
          </a>
          <a href="/uae/contact?topic=energy-transport" class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-600/50 px-7 py-3.5 text-sm font-semibold text-slate-300 hover:text-slate-100 hover:bg-slate-800/40 transition-colors">
            Enquire — UAE & GCC
          </a>
        </div>
        <a href="#what-we-do" class="inline-flex items-center justify-center lg:justify-start gap-2 text-sm font-medium text-slate-500 hover:text-teal-400 transition-colors">
          Explore consulting services
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg>
        </a>
      </div>

      <div class="relative">
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/40">
          <img
            src={energyTransport.image}
            alt="Celeson Energy Transport — ADR-compliant hydrocarbon tanker truck"
            class="w-full h-auto object-cover"
            loading="eager"
            width="1200"
            height="675"
          />
        </div>
      </div>
    </div>
  </div>
</section>
