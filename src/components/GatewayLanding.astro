---
import { hero } from '../data/content';

const regions = [
  {
    id: 'uae',
    href: '/uae',
    label: 'UAE & GCC',
    headline: hero.uae.headline,
    image: '/images/hero-uae-logistics.png',
    highlights: ['Logistics & Supply Chain', 'Transport Safety & IVMS', 'Port & Marine Services', 'Facility Management'],
    cta: 'Enter UAE & GCC',
  },
  {
    id: 'india',
    href: '/india',
    label: 'India',
    headline: 'Building a Zero-Accident Culture Across India',
    image: '/images/hero-india-control-room.png',
    highlights: ['Driver Management & IVMS', 'Control Room Operations', 'Road Safety Programs', 'In-Plant & Industrial Logistics'],
    cta: 'Enter India',
  },
];
---

<section id="regions" class="relative bg-[#0b1929] scroll-mt-24 pb-16 md:pb-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 md:mb-12">
      <div class="inline-flex items-center gap-2 rounded-full bg-teal-600/15 border border-teal-500/25 px-4 py-1.5 mb-4">
        <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest">Consulting & safety services by region</p>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-2">Where do you need Celeson?</h2>
      <p class="text-sm text-slate-500 max-w-xl mx-auto">Beyond energy transport, explore our consulting, safety, and operational services tailored to each market.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {regions.map((r) => (
        <a
          href={r.href}
          class="group gateway-region-card relative flex flex-col rounded-2xl overflow-hidden border border-white/10 bg-[#0f2137]/80 backdrop-blur-sm hover:border-teal-500/40 hover:shadow-2xl hover:shadow-teal-900/25 transition-all duration-500 hover:-translate-y-1"
        >
          <div class="relative h-48 sm:h-56 overflow-hidden">
            <img src={r.image} alt={r.headline} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="eager" width="640" height="360" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0f2137] via-[#0f2137]/60 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="inline-block rounded-full bg-teal-600/90 backdrop-blur px-3 py-1 text-[10px] font-bold text-white uppercase tracking-wider">{r.label}</span>
            </div>
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <h3 class="text-lg sm:text-xl font-bold text-white leading-snug mb-4 group-hover:text-teal-300 transition-colors">{r.headline}</h3>
            <ul class="space-y-2 mb-6 flex-1">
              {r.highlights.map(h => (
                <li class="flex items-center gap-2 text-sm text-slate-400">
                  <svg class="h-3.5 w-3.5 text-teal-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  {h}
                </li>
              ))}
            </ul>
            <span class="inline-flex items-center justify-center gap-2 rounded-full bg-teal-600 group-hover:bg-teal-500 px-6 py-3 text-sm font-semibold text-white transition-colors">
              {r.cta}
              <svg class="h-4 w-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
