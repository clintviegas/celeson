---
import { insights } from '../data/insights';

interface Props {
  region?: 'uae' | 'india' | 'home';
}
const { region = 'home' } = Astro.props;

const articles = region === 'home'
  ? insights.slice(0, 3)
  : insights.filter(a => a.region === region || a.region === 'both').slice(0, 3);
---

<section id="insights" class="py-16 md:py-24 bg-white border-t border-slate-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14">
      <div>
        <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Insights & Resources</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          Safety Guides & Case Studies
        </h2>
      </div>
      <a href="/insights" class="text-sm font-semibold text-teal-600 hover:text-teal-700 flex-shrink-0">
        View all articles →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {articles.slice(0, 3).map((article, i) => (
        <a
          href={`/insights/${article.slug}`}
          class="reveal-up group rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-xl hover:shadow-slate-200/60 hover:-translate-y-0.5 transition-all duration-300"
          style={`transition-delay: ${i * 60}ms`}
        >
          <div class="aspect-[16/10] overflow-hidden bg-slate-100">
            <img
              src={article.image}
              alt={article.title}
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
              loading="lazy"
              width="400"
              height="250"
            />
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="rounded-full bg-teal-50 text-teal-700 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide">
                {article.category}
              </span>
              <span class="text-xs text-slate-400">{article.readTime}</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 leading-snug mb-2 group-hover:text-teal-700 transition-colors">
              {article.title}
            </h3>
            <p class="text-sm text-slate-500 line-clamp-2">{article.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
