---
import { getCaseStudiesForRegion } from '../data/caseStudies';
import { getGlobalServiceTitle } from '../data/services';
import type { BusinessRegion } from '../data/brief';

interface Props {
  region: BusinessRegion;
  limit?: number;
}
const { region, limit = 3 } = Astro.props;
const studies = getCaseStudiesForRegion(region).slice(0, limit);
const base = `/${region}`;
const regionLabel = region === 'uae' ? 'UAE & GCC' : 'India';
---

<section class="py-14 md:py-20 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Proven Outcomes</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Featured Case Studies — {regionLabel}</h2>
      </div>
      <a href={`${base}/case-studies`} class="text-sm font-semibold text-teal-600 hover:text-teal-700 whitespace-nowrap">View all case studies →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {studies.map(cs => (
        <article class="rounded-2xl border border-slate-200 bg-slate-50 overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
          <div class="p-6 flex-1 flex flex-col">
            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-600 mb-2">{cs.client}</span>
            <h3 class="text-base font-bold text-slate-900 leading-snug mb-2">{cs.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1">{cs.summary}</p>
            {cs.serviceIds.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mb-4">
                {cs.serviceIds.slice(0, 2).map(id => (
                  <span class="text-[10px] rounded-full bg-white border border-slate-200 px-2 py-0.5 text-slate-500">{getGlobalServiceTitle(id)}</span>
                ))}
              </div>
            )}
            {cs.slug && (
              <a href={`${base}/insights/${cs.slug}`} class="text-sm font-semibold text-teal-600 hover:text-teal-700 mt-auto">Read case study →</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
