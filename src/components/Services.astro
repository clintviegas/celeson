---

<section id="services" class="py-16 md:py-24 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header: two-col layout on desktop so heading doesn't break -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14">
      <div>
        <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Where We Add Value</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          Safety Solutions Built Around<br class="hidden sm:block" /> Your Operations
        </h2>
      </div>
      <p class="text-slate-500 text-sm md:text-base leading-relaxed md:max-w-xs md:text-right md:flex-shrink-0">
        Every service designed with one goal: eliminate risk before it strikes.
      </p>
    </div>

    <!-- Service cards -->
    <div class={`grid gap-4 md:gap-5 ${region === 'india' ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2'}`}>
      {services.map((s, i) => (
        <div class="reveal-up group relative rounded-2xl border border-slate-200 bg-white p-5 md:p-7 hover:shadow-xl hover:shadow-slate-200/50 md:hover:-translate-y-1 transition-all duration-300 overflow-hidden active:scale-[0.99]" style={`transition-delay: ${i * 70}ms`}>
          <!-- Background gradient on hover -->
          <div class={`absolute inset-0 bg-gradient-to-br ${s.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>

          <div class="relative">
            <!-- Icon -->
            <div class={`mb-5 h-12 w-12 rounded-xl bg-slate-100 group-hover:bg-white p-2.5 ${s.iconColor} transition-colors`} set:html={s.icon} />

            <!-- Title -->
            <h3 class="text-lg font-bold text-slate-900 mb-2">{s.title}</h3>
            <p class="text-sm text-slate-500 mb-5 leading-relaxed">{s.desc}</p>

            <!-- Items -->
            <ul class="space-y-2">
              {s.items.map(item => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class={`mt-0.5 h-4 w-4 flex-shrink-0 ${s.iconColor}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
