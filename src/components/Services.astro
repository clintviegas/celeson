---
import { getServicesForRegion } from '../data/services';
import { countCaseStudiesForService } from '../data/caseStudies';
import type { BusinessRegion } from '../data/brief';

interface Props {
  region: BusinessRegion;
  linkable?: boolean;
  showOverview?: boolean;
}
const { region, linkable = true, showOverview = false } = Astro.props;
const services = getServicesForRegion(region);
const base = `/${region}`;
const sectionTitle = region === 'uae'
  ? 'Our Services — UAE & GCC'
  : 'Our Services — India';
---

<section class="py-16 md:py-24 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14 reveal-up">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">{sectionTitle}</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {services.map((s, i) => {
        const caseCount = countCaseStudiesForService(s.id, region);
        const href = `${base}/services/${s.id}`;
        const Tag = linkable ? 'a' : 'div';
        const tagProps = linkable ? { href } : {};
        return (
          <Tag
            {...tagProps}
            class={`reveal-up group relative rounded-2xl border border-slate-200 bg-white p-5 md:p-7 hover:shadow-xl hover:shadow-slate-200/50 md:hover:-translate-y-1 transition-all duration-300 overflow-hidden block ${linkable ? 'cursor-pointer' : ''}`}
            style={`transition-delay: ${i * 50}ms`}
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${s.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>
            <div class="relative">
              <div class="flex items-start justify-between gap-2 mb-4">
                <div class={`h-11 w-11 rounded-xl bg-slate-100 group-hover:bg-white p-2.5 ${s.iconColor} transition-colors`} set:html={s.icon} />
                {caseCount > 0 && (
                  <span class="text-[10px] font-semibold uppercase tracking-wider rounded-full bg-teal-50 text-teal-700 border border-teal-200 px-2 py-0.5 whitespace-nowrap">
                    {caseCount} case {caseCount === 1 ? 'study' : 'studies'}
                  </span>
                )}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{s.title}</h3>
              <p class="text-sm text-slate-500 mb-4 leading-relaxed">{s.desc}</p>
              <ul class="space-y-1.5 mb-4">
                {s.items.slice(0, showOverview ? s.items.length : 4).map(item => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <svg class={`mt-0.5 h-3.5 w-3.5 flex-shrink-0 ${s.iconColor}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
              {linkable && (
                <p class="text-sm font-semibold text-teal-600 group-hover:text-teal-700">View service →</p>
              )}
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</section>
