---
import { companyName } from '../data/content';
---

<section class="relative bg-[#0b1929] border-b border-white/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <p class="text-center text-sm sm:text-base text-slate-400 leading-relaxed max-w-3xl mx-auto">
      <span class="text-slate-200 font-semibold">{companyName}</span> combines specialist
      <a href="#energy-transport" class="text-teal-400 hover:text-teal-300 font-medium">Energy Transport</a>
      with consulting and safety services across India and the GCC — one company, two ways we serve you.
    </p>
  </div>
</section>
