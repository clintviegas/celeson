---
import { uaeRegionalOverview, indiaRegionalOverview } from '../data/services';

interface Props {
  region: 'uae' | 'india';
}
const { region } = Astro.props;
const data = region === 'uae' ? uaeRegionalOverview : indiaRegionalOverview;
---

<section class="py-12 md:py-16 bg-[#0b1929]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-10 reveal-up">
      <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest mb-2">
        {region === 'uae' ? 'Celeson UAE & GCC' : 'Celeson India'}
      </p>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">{data.headline}</h2>
      <p class="text-slate-400 leading-relaxed">{data.intro}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
      {data.categories.map((cat, i) => (
        <div class="reveal-up rounded-2xl border border-white/10 bg-white/5 p-5 md:p-6" style={`transition-delay:${i*50}ms`}>
          <h3 class="text-base font-bold text-teal-400 mb-3">{cat.title}</h3>
          <ul class="space-y-1.5">
            {cat.items.map(item => (
              <li class="flex items-start gap-2 text-sm text-slate-400">
                <svg class="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-teal-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="reveal-up rounded-2xl border border-white/10 bg-white/5 p-6">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Industries Served</p>
      <div class="flex flex-wrap gap-2">
        {data.industries.map(ind => (
          <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-slate-300">{ind}</span>
        ))}
      </div>
    </div>
  </div>
</section>
