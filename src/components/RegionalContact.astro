---
import { contact } from '../data/content';
import type { BusinessRegion } from '../data/brief';
import ReachOutForm from './ReachOutForm.astro';

interface Props {
  region: BusinessRegion;
}
const { region } = Astro.props;

const regionContact = region === 'uae' ? contact.uae : contact.india;
const regionLabel = region === 'uae' ? 'UAE & GCC' : 'India';
const officeAddress = region === 'uae' ? contact.uaeOffice.address : contact.headOffice.address;
const whatsappHref = `https://wa.me/${regionContact.whatsapp}?text=Hello%2C%20I%27d%20like%20to%20enquire%20about%20Celeson%20${encodeURIComponent(regionLabel)}%20services`;
---

<section id="contact" class="py-12 sm:py-16 md:py-24 bg-white scroll-mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 sm:gap-10 lg:gap-16 items-start">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-6 sm:mb-8">Contact — {regionLabel}</h2>

        <a
          href={`tel:${regionContact.tel}`}
          class="flex items-center gap-4 rounded-2xl border-2 border-teal-200 bg-teal-50 p-4 sm:p-5 mb-4 hover:border-teal-400 hover:shadow-lg transition-all group active:scale-[0.98]"
        >
          <div class="flex h-12 w-12 sm:h-14 sm:w-14 flex-shrink-0 items-center justify-center rounded-xl bg-teal-600 text-white">
            <svg class="h-6 w-6 sm:h-7 sm:w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          </div>
          <div>
            <p class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-teal-700">Call Us</p>
            <p class="text-sm text-slate-500 mt-0.5">Tap to call our {regionLabel} team</p>
          </div>
        </a>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 mb-4 hover:border-green-300 hover:shadow-md transition-all active:scale-[0.98]"
        >
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-green-500 text-white">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div>
            <p class="text-base font-semibold text-slate-900">WhatsApp</p>
            <p class="text-sm text-slate-500 mt-0.5">Message us on WhatsApp</p>
          </div>
        </a>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-5 mb-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">{region === 'uae' ? 'Regional Operations' : 'Head Office'}</p>
          <p class="text-sm text-slate-600 leading-relaxed">{officeAddress}</p>
        </div>

        <p class="text-sm text-slate-500">
          <a href={`mailto:${contact.email}`} class="text-teal-600 font-medium hover:text-teal-700">{contact.email}</a>
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6 md:p-8">
        <h3 class="text-lg font-bold text-slate-900 mb-6">Send a message</h3>
        <ReachOutForm region={region} />
      </div>
    </div>
  </div>
</section>
