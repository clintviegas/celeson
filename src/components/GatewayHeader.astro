---
import BrandLogo from './BrandLogo.astro';
import { tagline } from '../data/content';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0b1929]/85 backdrop-blur-xl border-b border-white/[0.08]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-[4.25rem] items-center justify-between gap-4">
      <BrandLogo href="/" size="md" subtitle={tagline.split('.')[0]} />
      <a href="#regions" class="hidden sm:inline-flex text-xs font-medium text-slate-400 hover:text-teal-400 border border-white/10 rounded-full px-4 py-2 transition-colors">
        Select Region ↓
      </a>
    </div>
  </div>
</header>
