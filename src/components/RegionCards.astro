---
import { hero } from '../data/content';

const regions = [
  {
    id: 'uae',
    href: '/services?region=uae',
    badge: hero.uae.badge,
    headline: hero.uae.headline,
    image: '/images/hero-uae-logistics.png',
    highlights: ['Logistics & Supply Chain', 'Transport Safety Solutions', 'Port & Marine Services', 'Facility Management'],
    accent: 'from-teal-500/20 to-blue-600/10',
    border: 'hover:border-teal-400/50',
  },
  {
    id: 'india',
    href: '/services?region=india',
    badge: hero.india.badge,
    headline: hero.india.headline,
    image: '/images/hero-india-highway.png',
    highlights: ['Supply Chain Consulting', 'Driver Management Systems', 'Road Safety Programs', 'Industrial Services'],
    accent: 'from-amber-500/20 to-teal-600/10',
    border: 'hover:border-amber-400/50',
  },
];
---

<section id="regions" class="py-16 md:py-24 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 reveal-up">
      <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Regional Presence</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        India & the UAE / GCC
      </h2>
      <p class="text-slate-500 text-sm md:text-base">
        Celeson operates across India and the Gulf — explore region-specific services, clients, and contact details.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
      {regions.map((r, i) => (
        <a
          href={r.href}
          class={`reveal-up group block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm ${r.border} hover:shadow-xl transition-all duration-300`}
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="relative h-48 sm:h-56 overflow-hidden">
            <img
              src={r.image}
              alt={r.headline}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="640"
              height="360"
            />
            <div class={`absolute inset-0 bg-gradient-to-t ${r.accent} to-[#0b1929]/60`} aria-hidden="true"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <span class="inline-block rounded-full bg-white/15 backdrop-blur-sm border border-white/20 px-3 py-1 text-xs font-semibold text-white uppercase tracking-wider mb-2">
                {r.badge}
              </span>
              <h3 class="text-xl sm:text-2xl font-extrabold text-white leading-tight">{r.headline}</h3>
            </div>
          </div>
          <div class="p-6 md:p-7">
            <ul class="space-y-2 mb-5">
              {r.highlights.map(h => (
                <li class="flex items-center gap-2 text-sm text-slate-600">
                  <svg class="h-3.5 w-3.5 text-teal-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {h}
                </li>
              ))}
            </ul>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-teal-600 group-hover:text-teal-700">
              View {r.id === 'uae' ? 'UAE' : 'India'} Services
              <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
