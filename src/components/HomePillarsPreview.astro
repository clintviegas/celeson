---
import { transportPillars } from '../data/content';
const preview = transportPillars.slice(0, 4);
const colors = ['text-teal-600', 'text-blue-600', 'text-purple-600', 'text-amber-600'];
---

<section class="py-16 md:py-24 bg-slate-50 border-y border-slate-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 reveal-up">
      <div>
        <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Transport Excellence</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Our Four Transportation Pillars</h2>
      </div>
      <a href="/about#pillars" class="text-sm font-semibold text-teal-600 hover:text-teal-700">View full framework →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {preview.map((pillar, i) => (
        <div class="reveal-up rounded-2xl border border-slate-200 bg-white p-5 hover:shadow-md transition-shadow" style={`transition-delay:${i*50}ms`}>
          <span class={`text-xl font-extrabold ${colors[i]} block mb-2`}>{pillar.num}</span>
          <h3 class="text-base font-bold text-slate-900 mb-2">{pillar.title}</h3>
          <p class="text-xs text-slate-500 leading-relaxed line-clamp-3">{pillar.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
