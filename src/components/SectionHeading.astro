---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}
const { eyebrow, title, description, align = 'center', dark = false } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-2xl';
---

<div class={`mb-10 md:mb-12 reveal-up ${alignClass}`}>
  <p class={`text-xs font-semibold uppercase tracking-widest mb-2 ${dark ? 'text-teal-400' : 'text-teal-600'}`}>{eyebrow}</p>
  <h2 class={`text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight ${dark ? 'text-white' : 'text-slate-900'}`}>{title}</h2>
  {description && <p class={`mt-3 text-sm md:text-base leading-relaxed ${dark ? 'text-slate-400' : 'text-slate-500'}`}>{description}</p>}
</div>
