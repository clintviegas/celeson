---
import { getCaseStudiesForRegion } from '../data/caseStudies';
import { getGlobalServiceTitle } from '../data/services';
import type { BusinessRegion } from '../data/brief';
import { getRegionLabel } from '../data/regionNav';

interface Props {
  region: BusinessRegion;
}
const { region } = Astro.props;
const studies = getCaseStudiesForRegion(region);
const regionLabel = getRegionLabel(region);
const base = `/${region}`;
---

<section class="py-16 md:py-24 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-6">
      {studies.map((cs) => (
        <article class="rounded-2xl border border-slate-200 bg-slate-50 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="p-6 md:p-7">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-600">{cs.client}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 leading-snug">{cs.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">{cs.summary}</p>
            {cs.serviceIds.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mb-4">
                {cs.serviceIds.map(id => (
                  <a href={`${base}/services/${id}`} class="text-[10px] rounded-full bg-white border border-slate-200 px-2 py-0.5 text-slate-500 hover:border-teal-300 hover:text-teal-700 transition-colors">{getGlobalServiceTitle(id)}</a>
                ))}
              </div>
            )}
            <ul class="space-y-1.5 mb-4">
              {cs.outcomes.map(o => (
                <li class="flex items-start gap-2 text-xs text-slate-600">
                  <svg class="mt-0.5 h-3 w-3 text-teal-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  {o}
                </li>
              ))}
            </ul>
            {cs.slug && (
              <a href={`${base}/insights/${cs.slug}`} class="text-sm font-semibold text-teal-600 hover:text-teal-700">Read full case study →</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
