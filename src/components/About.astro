---
import { vision, mission, values, philosophy, tagline, aboutServices, whoWeAre, valuePillars } from '../data/content';

const pillars = [
  { label: '33+ Years', desc: 'multinational leadership experience' },
  { label: 'Predict. Prevent. Protect.', desc: 'our core philosophy' },
  { label: 'Goal Zero', desc: 'no harm to people, assets, or environment' },
  { label: tagline.split('.')[0], desc: 'our commitment to every client' },
];
---

<section class="py-16 md:py-24 bg-[#0b1929] relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="dots-about" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" fill="white" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dots-about)" />
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mb-16 md:mb-20">
      <div>
        <p class="text-sm font-semibold text-teal-400 uppercase tracking-widest mb-3">About Celeson</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Who We Are
        </h2>
        <p class="text-slate-300 leading-relaxed mb-4">{whoWeAre}</p>
        <p class="text-slate-400 leading-relaxed mb-6">
          Having served multinational organizations across India and the GCC, we help businesses achieve operational excellence while maintaining the highest standards of safety, compliance, and sustainability.
        </p>
        <div class="grid grid-cols-2 gap-2">
          {aboutServices.map(service => (
            <div class="flex items-start gap-2 text-xs sm:text-sm text-slate-400">
              <svg class="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-teal-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              {service}
            </div>
          ))}
        </div>
      </div>

      <div class="relative space-y-5">
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-xl">
          <img
            src="/images/about-safety-leadership.png"
            alt="Celeson safety leadership in the field"
            class="w-full h-56 sm:h-64 object-cover object-center"
            loading="lazy"
            width="600"
            height="360"
          />
        </div>
        <div class="rounded-2xl border border-teal-500/30 bg-teal-500/5 p-6">
          <p class="text-xs font-semibold text-teal-400 uppercase tracking-widest mb-2">Our Core Philosophy</p>
          <p class="text-2xl font-extrabold text-white mb-2">{philosophy.headline}</p>
          <p class="text-sm text-slate-400 leading-relaxed">{philosophy.body}</p>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5 mb-8">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 md:p-7">
        <h3 class="text-lg font-bold text-teal-400 mb-3">Our Vision</h3>
        <p class="text-sm text-slate-400 leading-relaxed">{vision}</p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 md:p-7">
        <h3 class="text-lg font-bold text-teal-400 mb-3">Our Mission</h3>
        <ul class="space-y-2">
          {mission.map(m => (
            <li class="flex items-start gap-2 text-sm text-slate-400">
              <svg class="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-teal-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {m}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-6 md:p-7 mb-12">
      <h3 class="text-lg font-bold text-teal-400 mb-4">Our Values</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {valuePillars.map(v => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-bold text-white mb-1">{v.title}</div>
            <div class="text-xs text-slate-400 leading-relaxed">{v.desc}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-16 md:mb-20">
      {pillars.map(p => (
        <div class="rounded-xl border border-white/10 bg-white/5 p-4 text-center sm:text-left">
          <div class="text-base sm:text-lg font-bold text-teal-400 mb-1">{p.label}</div>
          <div class="text-xs sm:text-sm text-slate-400">{p.desc}</div>
        </div>
      ))}
    </div>

    <!-- Recognition & Leadership -->
    <div class="border-t border-white/10 pt-14">
      <p class="text-sm font-semibold text-teal-400 uppercase tracking-widest mb-2">Recognition & Leadership</p>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">The Face Behind Celeson</h3>
      <p class="text-slate-400 text-sm leading-relaxed mb-10 max-w-2xl">
        Arundhan Alphones — founder of Celeson Group — is an award-winning safety leader and a regular speaker at industry forums across the GCC and India.
      </p>

      <div class="grid md:grid-cols-2 gap-6">

        <!-- RoSPA Gold Award -->
        <div class="rounded-2xl overflow-hidden border border-white/10 bg-white/5 flex flex-col">
          <div class="relative overflow-hidden" style="height: 280px;">
            <img
              src="/images/arun-rospa-gold-award.png"
              alt="Arundhan Alphones receiving the RoSPA Gold Award in Birmingham, UK"
              class="w-full h-full object-cover object-top"
              loading="lazy"
              width="700"
              height="280"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b1929]/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-1 text-xs font-semibold text-amber-400 uppercase tracking-wider">
                🏆 RoSPA Gold Award — Birmingham, UK
              </span>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h4 class="text-white font-bold text-base mb-2">RoSPA Gold Award — Excellence in Health, Safety & Risk Management</h4>
              <p class="text-slate-400 text-sm leading-relaxed">
                Celeson was proud to receive the RoSPA Gold Award in Birmingham, UK — sponsored by NEBOSH — recognising excellence in health, safety, and risk management. A milestone reflecting strong teamwork, operational discipline, and commitment toward building a world-class safety culture.
              </p>
            </div>
            <p class="text-xs text-slate-500 mt-4 italic">"A proud milestone reflecting strong teamwork, operational discipline and commitment toward building a world-class safety culture."</p>
          </div>
        </div>

        <!-- Dubai Chamber Speaking -->
        <div class="rounded-2xl overflow-hidden border border-white/10 bg-white/5 flex flex-col">
          <div class="relative overflow-hidden" style="height: 280px;">
            <img
              src="/images/arun-dubai-chamber-speaker.png"
              alt="Arundhan Alphones speaking at Dubai Chamber Sustainability Network Road Safety Seminar"
              class="w-full h-full object-cover object-top"
              loading="lazy"
              width="700"
              height="280"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b1929]/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-500/20 border border-teal-500/40 px-3 py-1 text-xs font-semibold text-teal-400 uppercase tracking-wider">
                🎤 Dubai Chamber — Road Safety & Driver Awareness
              </span>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h4 class="text-white font-bold text-base mb-2">Dubai Chamber Sustainability Network — Industry Speaker</h4>
              <p class="text-slate-400 text-sm leading-relaxed">
                A regular presence at industry and community forums across the GCC — sharing perspectives on driver behaviour, operational excellence, transport safety, and fleet performance improvement. Committed to strengthening safety culture across the logistics and transport sector.
              </p>
            </div>
            <p class="text-xs text-slate-500 mt-4 italic">"Committed to strengthening safety culture and operational discipline across the logistics and transport sector."</p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
