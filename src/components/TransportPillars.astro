---
import { transportPillars } from '../data/content';

interface Props {
  theme?: 'default' | 'gateway';
}
const { theme = 'default' } = Astro.props;

const colors = ['text-teal-400', 'text-blue-400', 'text-purple-400', 'text-amber-400'];
const borders = ['border-teal-500/30', 'border-blue-500/30', 'border-purple-500/30', 'border-amber-500/30'];
const eyebrowClass = theme === 'gateway' ? 'text-brand-slate' : 'text-teal-600';
---

<section id="pillars" class="py-16 md:py-24 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 reveal-up">
      <p class={`text-xs font-semibold ${eyebrowClass} uppercase tracking-widest mb-2`}>Our Four Transportation Pillars</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        A Framework for Transport Excellence
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {transportPillars.map((pillar, i) => (
        <div class={`reveal-up rounded-2xl border ${borders[i]} bg-slate-50 p-6 md:p-8 hover:shadow-lg transition-shadow`} style={`transition-delay: ${i * 60}ms`}>
          <div class="flex items-center gap-3 mb-4">
            <span class={`text-2xl font-extrabold ${colors[i]}`}>{pillar.num}</span>
            <h3 class="text-lg font-bold text-slate-900">{pillar.title}</h3>
          </div>
          <p class="text-sm text-slate-500 mb-4 leading-relaxed">{pillar.desc}</p>
          <ul class="grid sm:grid-cols-2 gap-1.5">
            {pillar.items.map(item => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-600">
                <svg class={`mt-0.5 h-3.5 w-3.5 flex-shrink-0 ${colors[i]}`} fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
