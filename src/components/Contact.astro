---
import { contact, tagline } from '../data/content';

interface Props {
  region: 'uae' | 'india';
  compact?: boolean;
}
const { region, compact = false } = Astro.props;

const regionContact = region === 'uae' ? contact.uae : contact.india;
const phone1 = regionContact.phone;
const phone1Href = `tel:${regionContact.tel}`;
const whatsappHref = `https://wa.me/${regionContact.whatsapp}?text=Hello%2C%20I%27d%20like%20to%20enquire%20about%20Celeson%20services`;
const whatsappDisplay = regionContact.phone;
---

<section id="contact" class="py-16 md:py-24 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {!compact && (
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-16">
      <p class="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-2">Get In Touch</p>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Contact Celeson Group
      </h2>
      <p class="text-slate-500 text-base md:text-lg leading-relaxed">
        {tagline} Reach us via WhatsApp, email, or phone — we respond promptly to every enquiry.
      </p>
    </div>
    )}

    <div class="grid lg:grid-cols-2 gap-6 md:gap-12 items-start">
      <div class="space-y-4">
        <!-- Head Office -->
        <div class="flex items-start gap-4 md:gap-5 rounded-2xl border border-slate-200 bg-white p-5 md:p-6">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mb-0.5">Head Office</div>
            <div class="text-sm font-semibold text-slate-900 mb-1">{contact.headOffice.name}</div>
            <div class="text-sm text-slate-500 leading-relaxed">{contact.headOffice.address}</div>
          </div>
        </div>

        <!-- Phone -->
        <a href={phone1Href} class="tap-scale group flex items-center gap-4 md:gap-5 rounded-2xl border border-slate-200 bg-white p-5 md:p-6 hover:border-teal-300 hover:shadow-lg hover:shadow-teal-50 transition-all active:scale-[0.99]">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600 group-hover:bg-teal-100 transition-colors">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mb-0.5">Phone {region === 'uae' ? '(UAE)' : '(India)'}</div>
            <div class="text-lg font-semibold text-slate-900 group-hover:text-teal-700 transition-colors">{phone1}</div>
          </div>
        </a>

        <!-- WhatsApp -->
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="tap-scale group flex items-center gap-4 md:gap-5 rounded-2xl border border-slate-200 bg-white p-5 md:p-6 hover:border-green-300 hover:shadow-lg hover:shadow-green-50 transition-all active:scale-[0.99]">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-green-50 text-green-600 group-hover:bg-green-100 transition-colors">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mb-0.5">WhatsApp</div>
            <div class="text-lg font-semibold text-slate-900 group-hover:text-green-700 transition-colors">{whatsappDisplay}</div>
            <div class="text-sm text-slate-400">Message us directly — fastest response</div>
          </div>
        </a>

        <!-- Email -->
        <a href={`mailto:${contact.email}`} class="tap-scale group flex items-center gap-4 md:gap-5 rounded-2xl border border-slate-200 bg-white p-5 md:p-6 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-50 transition-all active:scale-[0.99]">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 group-hover:bg-blue-100 transition-colors">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mb-0.5">Email</div>
            <div class="text-base font-semibold text-slate-900 group-hover:text-blue-700 transition-colors">{contact.email}</div>
            <div class="text-sm text-slate-400">{contact.website}</div>
          </div>
        </a>
      </div>

      <!-- CTA Card -->
      <div class="rounded-2xl bg-[#0b1929] p-8 lg:p-10 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-teal-600/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-white mb-3">Ready to build a safer operation?</h3>
            <p class="text-slate-400 leading-relaxed">
              From logistics fleets to facility management — Celeson delivers integrated solutions across India and the GCC. WhatsApp or email us for a prompt response.
            </p>
          </div>

          <div class="space-y-3 mb-8">
            {['Free initial consultation', 'Customised safety assessment', 'Practical, actionable report', 'Ongoing support available'].map(item => (
              <div class="flex items-center gap-3 text-sm text-slate-300">
                <svg class="h-4 w-4 text-teal-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </div>
            ))}
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center gap-2 rounded-full bg-green-500 px-5 py-3 text-sm font-semibold text-white hover:bg-green-400 transition-all"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Chat on WhatsApp
            </a>
            <a
              href={`mailto:${contact.email}`}
              class="flex-1 inline-flex items-center justify-center gap-2 rounded-full border border-white/20 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-all"
            >
              Send an Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
