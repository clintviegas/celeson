---
import { getServiceById } from '../data/services';
import { getCaseStudiesForService } from '../data/caseStudies';
import type { BusinessRegion } from '../data/brief';
import ValueImpact from './ValueImpact.astro';

interface Props {
  region: BusinessRegion;
  serviceId: string;
}
const { region, serviceId } = Astro.props;

const service = getServiceById(serviceId, region);
if (!service) {
  throw new Error(`Service not found: ${serviceId}`);
}

const related = getCaseStudiesForService(serviceId, region);
const base = `/${region}`;
---

<section class="py-12 md:py-16 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <div class={`inline-flex h-14 w-14 rounded-2xl bg-slate-100 p-3 mb-6 ${service.iconColor}`} set:html={service.icon} />
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">{service.title}</h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-8">{service.desc}</p>
    </div>

    {service.heroImage && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-slate-200 shadow-lg max-w-4xl">
        <img
          src={service.heroImage}
          alt={service.title}
          class="w-full h-auto object-cover max-h-[420px]"
          loading="eager"
          width="1200"
          height="675"
        />
      </div>
    )}

    <div class="grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        {service.subsections ? (
          service.subsections.map(sub => (
            <div class="mb-8">
              <h2 class="text-lg font-bold text-slate-900 mb-3">{sub.title}</h2>
              <ul class="grid sm:grid-cols-2 gap-2">
                {sub.items.map(item => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <svg class={`mt-0.5 h-4 w-4 flex-shrink-0 ${service.iconColor}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        ) : (
          <ul class="grid sm:grid-cols-2 gap-3">
            {service.items.map(item => (
              <li class="flex items-start gap-2 text-sm text-slate-600 rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
                <svg class={`mt-0.5 h-4 w-4 flex-shrink-0 ${service.iconColor}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                {item}
              </li>
            ))}
          </ul>
        )}

      </div>

      <div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sticky top-24">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">Related Work</h2>
          {related.length === 0 ? (
            <p class="text-sm text-slate-500">Case studies for this service are coming soon. <a href={`${base}/contact`} class="text-teal-600 font-medium">Get in touch</a> to discuss your requirements.</p>
          ) : (
            <ul class="space-y-4">
              {related.map(cs => (
                <li>
                  {cs.slug ? (
                    <a href={`${base}/insights/${cs.slug}`} class="block group">
                      <p class="text-[10px] font-bold uppercase tracking-wider text-teal-600 mb-1">{cs.client}</p>
                      <p class="text-sm font-bold text-slate-900 group-hover:text-teal-700 leading-snug">{cs.title}</p>
                    </a>
                  ) : (
                    <div class="block">
                      <p class="text-[10px] font-bold uppercase tracking-wider text-teal-600 mb-1">{cs.client}</p>
                      <p class="text-sm font-bold text-slate-900 leading-snug">{cs.title}</p>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}
          <a href={`${base}/contact`} class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-teal-600 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-500 transition-colors">
            Discuss this service
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
{serviceId === 'transport-safety' && region === 'india' && <ValueImpact />}
