---
import Layout from '../layouts/Layout.astro';
import GatewayHeader from '../components/GatewayHeader.astro';
import GatewayHero from '../components/GatewayHero.astro';
import GatewayLanding from '../components/GatewayLanding.astro';
import GatewayAbout from '../components/GatewayAbout.astro';
import TransportPillars from '../components/TransportPillars.astro';
import { companyName } from '../data/content';
---

<Layout
  title={`${companyName} | Safety, Logistics & Operational Excellence`}
  description="Celeson Enterprise Pvt Ltd — 33+ years of safety, logistics and operational excellence across India and the GCC. Select your region to explore services."
  region="home"
  canonicalURL="https://celesongroup.com"
>
  <GatewayHeader />
  <main class="bg-[#0b1929]">
    <GatewayHero />
    <GatewayLanding />
    <GatewayAbout />
    <TransportPillars />
  </main>
</Layout>
