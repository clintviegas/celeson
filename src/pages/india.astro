  region="india"
  canonicalURL="https://celesongroup.com/india"
>
  <Header region="india" />
  <main>
    <Hero region="india" />
    <Services region="india" />
    <Process />
    <About region="india" />
    <Contact region="india" />
  </main>
  <Footer region="india" />
  <WhatsAppFloat region="india" />
  <MobileBar region="india" />
</Layout>
